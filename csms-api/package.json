{
  "name": "csms-api",
  "version": "1.0.0",
  "description": "CSMS API Service",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "build:lambda": "npm run build",
    "start": "dotenv -e ../.env -- nest start",
    "start:dev": "dotenv -e ../.env -- prisma generate && dotenv -e ../.env -- nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../.env -- prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/lib-dynamodb": "^3.1131.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "typescript": "5.9.3"
  }
}
