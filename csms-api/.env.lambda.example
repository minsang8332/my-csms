# AWS Lambda runtime (configure the corresponding resources in the AWS console)
NODE_ENV=production
STORAGE_DRIVER=dynamodb
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# DynamoDB table names
CSMS_ITEMS_TABLE=csms-items
CSMS_CASES_TABLE=csms-cases
CSMS_CASE_REPLIES_TABLE=csms-case-replies
CSMS_SHIPPED_ITEMS_TABLE=csms-shipped-items
CSMS_DAILY_VOTES_TABLE=csms-daily-votes
CSMS_USERS_TABLE=csms-users
CSMS_AUTH_SESSIONS_TABLE=csms-auth-sessions

# Private attachment bucket used by future presigned upload endpoints
CSMS_ATTACHMENTS_BUCKET=csms-attachments
