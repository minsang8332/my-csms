generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

model User {
  id          String    @id @default(uuid()) @db.VarChar(36)
  email       String    @unique @db.VarChar(191)
  password    String    @db.VarChar(191)
  name        String    @db.VarChar(191)
  group       String    @db.VarChar(191)
  authVersion Int       @default(0) @map("auth_version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  auths Auth[]
  roles UserRole[]

  @@map("users")
}

model Auth {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  userId              String    @map("user_id") @db.VarChar(36)
  refreshToken        String?   @map("refresh_token") @db.Text
  tokenHash           String?   @map("token_hash") @db.VarChar(255)
  familyId            String?   @map("family_id") @db.VarChar(36)
  parentSessionId     String?   @map("parent_session_id") @db.VarChar(36)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)
  expiresAt           DateTime  @map("expires_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Cs {
  id                String    @id @default(uuid()) @db.VarChar(36)
  name              String    @db.VarChar(191)
  address           String    @db.VarChar(191)
  contact           String    @db.VarChar(191)
  status            String    @default("문의접수") @db.VarChar(20)
  licensePath       String?   @map("license_path") @db.VarChar(191)
  licenseName       String?   @map("license_name") @db.VarChar(191)
  description       String?   @db.Text
  shippedAt         DateTime? @map("shipped_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  receivedAt        DateTime? @map("received_at") @db.DateTime(3)

  items   ShippedItem[]
  replies CsReply[]

  @@map("cs")
}

model CsReply {
  id        String   @id @default(uuid()) @db.VarChar(36)
  csId      String   @map("cs_id") @db.VarChar(36)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  cs Cs @relation(fields: [csId], references: [id], onDelete: Cascade)

  @@map("cs_replies")
}

model Item {
  id    String @id @default(uuid()) @db.VarChar(36)
  name  String @unique @db.VarChar(191)
  price Int
  count Int

  shippedItems ShippedItem[]

  @@map("items")
}

model ShippedItem {
  id     String  @id @default(uuid()) @db.VarChar(36)
  csId   String  @map("cs_id") @db.VarChar(36)
  itemId String? @map("item_id") @db.VarChar(36)
  name   String  @db.VarChar(191)
  price  Int
  count  Int

  cs   Cs    @relation(fields: [csId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("shipped_items")
}
