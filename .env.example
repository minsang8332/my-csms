NODE_ENV=development
BUILD_TARGET=development
API_VOLUME_MOUNT=./csms-api/src
API_COMMAND=npm run start:dev
DOMAIN=localhost
PORT=3000

# 로컬 호스트에서 직접 실행하는 명령이 사용합니다.
DATABASE_URL="mysql://csms_user:replace-with-a-strong-password@127.0.0.1:3306/csms"
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# MariaDB Docker 컨테이너가 사용합니다.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=csms
MYSQL_USER=csms_user
MYSQL_PASSWORD=replace-with-a-strong-password

# Docker Compose 내부의 API가 MariaDB 컨테이너에 연결할 때 사용합니다.
DB_HOST=csms-db
DB_PORT=3306
DATABASE_URL_DOCKER="mysql://csms_user:replace-with-a-strong-password@csms-db:3306/csms"
