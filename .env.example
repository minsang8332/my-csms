NODE_ENV=development
DOMAIN=localhost
PORT=3000

JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# 저장소 드라이버: Docker 로컬 개발은 mysql, Lambda 배포는 dynamodb
STORAGE_DRIVER=mysql

# 최초 최고관리자 계정 시드. Git에 실제 비밀번호를 올리지 마세요.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_NAME=최고관리자
SUPER_ADMIN_GROUP=관리자

# 로컬 호스트에서 Prisma 명령을 직접 실행할 때 사용하는 MySQL 연결 URL입니다.
MYSQL_DATABASE_URL="mysql://csms_user:replace-with-a-strong-password@127.0.0.1:3306/csms"

# Docker Compose 전용 설정
DOCKER_BUILD_TARGET=development
DOCKER_API_VOLUME_MOUNT=./csms-api/src
DOCKER_API_COMMAND=npm run start:dev

# Docker MariaDB 컨테이너 설정
DOCKER_MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DOCKER_MYSQL_DATABASE=csms
DOCKER_MYSQL_USER=csms_user
DOCKER_MYSQL_PASSWORD=replace-with-a-strong-password
DOCKER_MYSQL_HOST=csms-db
DOCKER_MYSQL_PORT=3306
